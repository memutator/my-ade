{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "//": [
    "IMP-01: allowImportingTsExtensions lets the renderer type-import",
    "mahas-contracts with the same explicit .ts specifier convention (see",
    "packages/README.md); rewriteRelativeImportExtensions keeps emit legal."
  ],
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    }
  }
}
